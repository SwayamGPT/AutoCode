# AutoCode configuration. Copy to .env (project) or ~/.autocode/.env (desktop app) and change what you need.
# Every value is optional: leaving a line empty or deleting it keeps the default shown.
# Precedence: built-in defaults < this file < real environment variables < settings saved in the app.
# (The app's Settings screen writes ~/.autocode/settings.json, which wins over this file for the fields it saves.)

# =====================================================================================================
# Models
# =====================================================================================================
# A model is "<provider>:<model>". Providers: ollama, lmstudio, openai, anthropic, gemini, groq,
# openrouter, deepseek, mistral, together, or a custom one from PROVIDERS_JSON. A bare name ("qwen3:4b")
# means an Ollama model.
#
# Free hosted options (no card needed, rate-limited):
#   MODEL=groq:llama-3.3-70b-versatile         + GROQ_API_KEY        (console.groq.com)
#   MODEL=gemini:gemini-2.5-flash              + GEMINI_API_KEY      (aistudio.google.com/apikey)
#   MODEL=openrouter:<any model ending :free>  + OPENROUTER_API_KEY  (openrouter.ai)
MODEL=
# Kept for older setups; used when MODEL is empty.
OLLAMA_MODEL=qwen3:4b

# Optional per-step models (empty = MODEL). Example: a strong hosted planner with fast local reviewers.
PLANNER_MODEL=
CODER_MODEL=
REVIEWER_MODEL=
CRITIC_MODEL=

# Embeddings for memory search. If unavailable, memory falls back to keyword matching automatically.
# Use "hash" to skip embeddings entirely, or e.g. openai:text-embedding-3-small.
EMBEDDING_MODEL=ollama:nomic-embed-text

# Sampling and context
LLM_TEMPERATURE=0.2
# Ollama context window in tokens.
LLM_NUM_CTX=8192
# Seconds to wait for one model reply.
OLLAMA_REQUEST_TIMEOUT_SECONDS=600
# Extra attempts when a model returns invalid JSON.
LLM_JSON_RETRIES=1

# =====================================================================================================
# Providers and API keys
# =====================================================================================================
OLLAMA_HOST=http://localhost:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=

# Point any preset at a proxy or mirror: <NAME>_BASE_URL, for example
# OPENAI_BASE_URL=https://my-proxy.example.com/v1
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
OPENAI_BASE_URL=
GROQ_BASE_URL=
LMSTUDIO_BASE_URL=

# Add or override providers as JSON (any OpenAI-compatible server works):
# PROVIDERS_JSON={"vllm": {"type": "openai", "base_url": "http://gpu-box:8000/v1", "api_key": ""}}
PROVIDERS_JSON=

# Attempts on rate limits (429) and server errors, with backoff.
HTTP_RETRIES=3
# Anthropic: reply size, and whether a safety-declined request is retried on a fallback model.
ANTHROPIC_MAX_TOKENS=16000
ANTHROPIC_FALLBACKS=true

# =====================================================================================================
# Pipeline
# =====================================================================================================
# true = one generation pass instead of one per quality dimension (far fewer model calls).
FAST_MODE=false
# Review rounds (test -> review -> patch).
MAX_ITERATIONS=2
# Minimum score (0-100) every reviewer must give.
PASSING_SCORE=85
# Files each reviewer sees.
MAX_RETRIEVED_FILES=5
# true = do not run the generated project's test command.
SKIP_VERIFY=false
# Seconds before a test command or MCP tool call is stopped.
COMMAND_TIMEOUT_SECONDS=60
# Characters of test output kept for the fixer and the timeline.
COMMAND_OUTPUT_CHARS=4000

# How much source each step may read (characters).
GENERATOR_CONTEXT_CHARS=24000
IMPLEMENT_CONTEXT_CHARS=20000
FIX_CONTEXT_CHARS=20000
FIX_OUTPUT_CHARS=4000
# Limits on each dimension plan (items per list, characters per item).
PLAN_MAX_ITEMS=8
PLAN_MAX_ITEM_CHARS=300

# Reading an existing project: biggest file, most files, and extra folder names to skip (comma-separated).
WORKSPACE_MAX_FILE_BYTES=200000
WORKSPACE_MAX_FILES=400
WORKSPACE_IGNORE=

# =====================================================================================================
# Memory and learning
# =====================================================================================================
LEARNING=true
# Empty = the docker compose Postgres if it is running, otherwise a local SQLite file.
# "sqlite" forces the local file. Or a full URL: postgresql://user:pass@host:5432/autocode (needs pgvector).
DATABASE_URL=
PG_CONNECT_TIMEOUT=3
# Lessons recalled per quality dimension, and the minimum similarity (0-1) to use one.
RECALL_PER_DIMENSION=3
RECALL_MIN_SIMILARITY=0.25
# Lessons the critic may store per run, and their maximum length.
MAX_LESSONS_PER_RUN=20
MAX_LESSON_CHARS=400
# SQLite only: how many recent memories a search compares against.
MEMORY_SEARCH_CANDIDATES=2000

# =====================================================================================================
# Tools and other agents
# =====================================================================================================
# MCP servers file for the context agent (Claude/Cursor "mcpServers" format). Empty = ~/.autocode/mcp.json
MCP_CONFIG=
MCP_MAX_TOOL_CALLS=3
MCP_MAX_RESULT_CHARS=4000
# Longest diff the MCP generate_code tool returns.
MCP_MAX_DIFF_CHARS=20000
# Other A2A agents used as extra reviewers, comma-separated.
A2A_PEERS=

# =====================================================================================================
# Agent mode (file edits, shell, git, GitHub)
# =====================================================================================================
# ask (default): shell commands, commits, pushes, pulls, deletes and GitHub writes wait for your approval.
# auto: no questions. read_only: the agent may only read.
AGENT_APPROVAL=ask
AGENT_MAX_STEPS=30
# How much of the agent's earlier steps it re-reads each turn (characters), and per-tool output limits.
AGENT_TRANSCRIPT_CHARS=24000
TOOL_OUTPUT_CHARS=8000
TOOL_MAX_READ_LINES=400
TOOL_MAX_SEARCH_HITS=100
# GitHub personal access token (fine-grained: contents, pull requests, issues) for the GitHub tools.
# git push/pull use your normal git credentials.
GITHUB_TOKEN=
# GitHub Enterprise: https://github.example.com/api/v3
GITHUB_API_URL=https://api.github.com

# =====================================================================================================
# App, server and storage
# =====================================================================================================
# Where settings, logs, memory and run history live. Default ~/.autocode
AUTOCODE_HOME=
# `python app.py serve` address. Keep 127.0.0.1 unless you know why: the server has no login.
UI_HOST=127.0.0.1
UI_PORT=8000
MAX_REQUEST_BYTES=1000000
SSE_HEARTBEAT_SECONDS=15
# Runs kept in history.
MAX_SAVED_RUNS=50
# Health checks and model downloads (seconds).
HEALTH_TIMEOUT_SECONDS=3
MODEL_PULL_TIMEOUT_SECONDS=3600
# Logging: DEBUG, INFO, WARNING or ERROR; size per log file and number of rotated files.
LOG_LEVEL=INFO
LOG_MAX_BYTES=2000000
LOG_BACKUPS=3

# CLI only: the requirement to run when none is given on the command line.
APP_REQUIREMENT=

# =====================================================================================================
# Docker compose (scripts/start.sh / docker compose up)
# =====================================================================================================
OLLAMA_IMAGE_TAG=latest
OLLAMA_PORT=11434
# Ollama embedding model pulled at startup (EMBEDDING_MODEL is set from it inside compose).
EMBEDDING_OLLAMA_MODEL=nomic-embed-text
POSTGRES_PASSWORD=autocode
POSTGRES_PORT=5432
