OLLAMA_IMAGE_TAG=latest
OLLAMA_MODEL=qwen3:4b
OLLAMA_HOST=http://localhost:11434
OLLAMA_PORT=11434
OLLAMA_REQUEST_TIMEOUT_SECONDS=600

LLM_TEMPERATURE=0.2
LLM_NUM_CTX=8192

# Fast mode: one generation pass. Default: plan all ten dimensions, then implement each one in turn.
FAST_MODE=false
MAX_ITERATIONS=2
PASSING_SCORE=85
MAX_RETRIEVED_FILES=5
SKIP_VERIFY=false
COMMAND_TIMEOUT_SECONDS=60

OLLAMA_HEALTHCHECK_INTERVAL=10s
OLLAMA_HEALTHCHECK_TIMEOUT=5s
OLLAMA_HEALTHCHECK_RETRIES=30

# Models: "<provider>:<model>", e.g. ollama:qwen3:4b, openai:gpt-5-mini, anthropic:claude-opus-5-5,
# gemini:gemini-2.5-flash. Role models are optional (empty = MODEL). Everything here can also be set in the app.
MODEL=
PLANNER_MODEL=
CODER_MODEL=
REVIEWER_MODEL=
CRITIC_MODEL=
EMBEDDING_MODEL=ollama:nomic-embed-text
# API keys for hosted models (or paste them in Settings).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Memory and learning. Empty DATABASE_URL = the docker compose Postgres if running, else a local file.
DATABASE_URL=
LEARNING=true

# Optional: MCP servers the context agent may call, and A2A agents used as extra reviewers.
# Empty = ~/.autocode/mcp.json
MCP_CONFIG=
A2A_PEERS=

UI_HOST=127.0.0.1
UI_PORT=8000

APP_REQUIREMENT=
